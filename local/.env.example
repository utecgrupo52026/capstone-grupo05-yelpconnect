# Copiar este archivo como .env (NO se sube a git) y completar.
# Databricks → SQL Warehouses → (tu warehouse) → Connection details
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# Databricks → (tu usuario) → Settings → Developer → Access tokens
DATABRICKS_TOKEN=dapi_reemplazar
